# Copy this to .env and fill in real values. Never commit the real .env.

BACKEND_URL=http://localhost:8080
INTERNAL_API_KEY=change-this-shared-secret

# Must match application.properties on the backend.

CAMERA_INDEX=0
SCAN_INTERVAL_SECONDS=600
FACE_MATCH_TOLERANCE=0.6

# Identifies which physical room/camera this instance covers - supports
# running recognize.py in multiple classrooms simultaneously against the
# same backend.
CLASSROOM_NAME=Room-101

# GPS coordinates this camera reports with each scan, checked against the
# backend's geofence.campus-* config. If you don't have a GPS sensor on
# the machine, hardcode the classroom's known coordinates here - that's
# the realistic setup for a fixed classroom camera anyway.
CAMERA_LATITUDE=28.6692
CAMERA_LONGITUDE=77.4538

# Liveness (basic anti-spoofing via blink detection) - see recognize.py.
# Number of consecutive frames used to detect a blink before a match is
# accepted as "live" rather than a photo/screen held up to the camera.
LIVENESS_CHECK_FRAMES=15
LIVENESS_EAR_THRESHOLD=0.21

# If true, saves a snapshot image whenever an unrecognized face is
# detected, for the unknown-person alert.
SAVE_UNKNOWN_SNAPSHOTS=true
